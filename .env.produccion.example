# ===========================================================================
# TrackIn — variables del servidor (`TASK-09`, docs/deployment.md).
#
#   Copy-Item .env.produccion.example .env.produccion     # y completar
#   docker compose --env-file .env.produccion up -d
#
# `.env.produccion` NO se sube al repositorio (.gitignore). Guardarlo donde TI
# guarde los secretos del servidor, no en una carpeta compartida.
# ===========================================================================

# --- Base de datos ----------------------------------------------------------
POSTGRES_USER=trackin
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=trackin

# --- API y worker -----------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# Firma las sesiones. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarla cierra todas las sesiones abiertas.
SECRET_KEY=
# El dominio público del panel, con https. Con nginx en el mismo origen no hace
# falta para el panel; sirve si otra aplicación llama a la API.
BACKEND_CORS_ORIGINS=https://trackin.gutis.com

# Token de la API de ShipsGo (Settings → API de la cuenta de Gutis).
# Vacío: el sistema funciona pero no rastrea.
SHIPSGO_API_TOKEN=

# Clave que SAP manda en `X-API-Key` al enviar pedidos (`US-65`). Vacía: el
# receptor responde 503. La escucha además arranca apagada: la enciende el
# Administrador en Configuración → Integración con SAP.
SAP_INTEGRACION_CLAVE=

# --- Panel (se fijan al CONSTRUIR la imagen: cambiarlas exige rebuild) -----
# Vacía: el panel llama a la API en su mismo origen (recomendado).
VITE_API_URL=
# Mapa en vivo de ShipsGo en el detalle. Es otro token, no el de la API, y va
# en el navegador: el dominio público tiene que estar en «Allowed HTTP Origins»
# de la cuenta de ShipsGo. Vacío: el detalle usa el mapa propio.
VITE_SHIPSGO_EMBED_TOKEN=
# Fondo de los mapas. Vacías: OpenStreetMap (tile.openstreetmap.org). Para el
# plan B (Stadia Maps Starter) ver docs/deployment.md §5. Solo https y sin {s}.
VITE_MOSAICOS_URL=
VITE_MOSAICOS_ATRIBUCION=

# --- Avisos por correo (scripts/vigilar_salud.sh, PROD-08) ------------------
# Solo si TI no vigila /health con su propia herramienta (docs/deployment.md §9).
# El servidor de correo que indique TI: smtp://host:25 (relé interno),
# smtp://host:587 con usuario, o smtps://host:465. Vacío: el aviso queda solo en
# vigilancia/vigilar.log.
AVISO_SMTP_URL=
AVISO_SMTP_USUARIO=
AVISO_SMTP_CLAVE=
AVISO_DE=trackin@gutis.com
# Uno o varios, separados por coma.
AVISO_PARA=
# Horas que una fuente puede estar degradada antes de avisar.
AVISO_FUENTE_HORAS=1

# --- Red ---------------------------------------------------------------------
# El puerto del servidor donde escucha el panel. El proxy con TLS apunta acá.
TRACKIN_PUERTO=8080
