# ===========================================================================
# TrackIn frontend — variables de entorno.
#
#   Copy-Item .env.example .env
#
# Vite solo expone al navegador las variables con prefijo VITE_.
# ¡No pongas secretos acá! Todo lo que empiece con VITE_ termina embebido
# en el bundle y es visible para cualquiera que abra el sitio.
# ===========================================================================

# URL base de la API. En Docker el navegador sigue hablando con localhost,
# porque el fetch sale desde tu máquina, no desde el contenedor.
VITE_API_URL=http://localhost:8000

# Token del ShipsGo Embed: el mapa en vivo del detalle del pedido (21/10/2026).
# NO es el token de la API (ese vive solo en el backend). Va en el navegador, así
# que lo protege la lista «Allowed HTTP Origins» de la cuenta de ShipsGo: agregue
# ahí el origen del frontend (http://localhost:5173 en desarrollo). Vacío = el
# detalle usa solo el mapa propio.
VITE_SHIPSGO_EMBED_TOKEN=
