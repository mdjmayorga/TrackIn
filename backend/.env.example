# ===========================================================================
# Overrides locales SOLO del backend.
#
# La configuración principal vive en el `.env` de la RAÍZ del repositorio,
# que es el que consume docker-compose y también lee `app/core/config.py`.
# Este archivo es opcional: usalo cuando quieras apuntar el backend a otra
# base sin tocar el resto del stack. Tiene MENOR precedencia que el .env raíz.
#
#   Copy-Item .env.example .env
# ===========================================================================

# Ejemplo: correr contra una base de pruebas separada.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=trackin_test

# Ejemplo: DSN completo (tiene precedencia sobre las POSTGRES_* de arriba).
# DATABASE_URL=postgresql+asyncpg://trackin:password@localhost:5432/trackin_test

# ENVIRONMENT=development
# DEBUG=true
