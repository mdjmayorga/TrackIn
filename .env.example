# ===========================================================================
# TrackIn — plantilla de variables de entorno
# Copiar a `.env` y completar. NUNCA commitear el `.env` real.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# ===========================================================================

# --- PostgreSQL + PostGIS --------------------------------------------------
POSTGRES_USER=trackin
POSTGRES_PASSWORD=<generar-password-seguro>
POSTGRES_DB=trackin_dev

# OJO con el host: depende de DÓNDE corre el proceso que se conecta.
#   - `localhost`  -> uvicorn/psql corriendo en tu máquina (perfil dev)
#   - `postgres`   -> proceso dentro de la red de docker-compose
# docker-compose ya sobreescribe esto a `postgres` para el servicio backend,
# así que dejalo en `localhost` para el desarrollo local.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Opcional: si se define, tiene precedencia sobre las POSTGRES_* de arriba.
# Útil para apuntar a una base gestionada en despliegue.
# DATABASE_URL=postgresql+asyncpg://trackin:<password>@postgres:5432/trackin_dev

# --- pgAdmin (solo desarrollo) ---------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@trackin.local
PGADMIN_DEFAULT_PASSWORD=<generar-password-seguro>
PGADMIN_PORT=5050

# --- Backend ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Clave para firmar tokens/sesiones (aún sin uso en Sprint 0).
SECRET_KEY=<generar-clave-aleatoria>

# --- APIs externas (se usan a partir de sprints posteriores) ---------------
# https://aisstream.io/documentation
AISSTREAM_API_KEY=<placeholder>
# https://openskynetwork.github.io/opensky-api/
OPENSKY_USERNAME=<placeholder>
OPENSKY_PASSWORD=<placeholder>

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
